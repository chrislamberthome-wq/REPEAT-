{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/chrislamberthome-wq/REPEAT-/spintronics/schemas/trace_integrity_v1.schema.json",
  "title": "Trace Integrity v1",
  "description": "Schema for pulse-trace validity verification in spintronics experiments",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "timestamp",
    "pulse_sequence",
    "integrity_check"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trace_integrity_v1",
      "description": "Schema version identifier"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Unique trace identifier (SHA-256 hex)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of trace creation"
    },
    "pulse_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "amplitude", "duration", "pulse_type"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "description": "Pulse index in sequence"
          },
          "amplitude": {
            "type": "number",
            "description": "Pulse amplitude in volts"
          },
          "duration": {
            "type": "number",
            "minimum": 0,
            "description": "Pulse duration in nanoseconds"
          },
          "pulse_type": {
            "type": "string",
            "enum": ["write", "read", "reset", "idle"],
            "description": "Type of pulse operation"
          },
          "rise_time": {
            "type": "number",
            "minimum": 0,
            "description": "Pulse rise time in nanoseconds"
          },
          "fall_time": {
            "type": "number",
            "minimum": 0,
            "description": "Pulse fall time in nanoseconds"
          }
        }
      },
      "description": "Sequence of pulses in the trace"
    },
    "integrity_check": {
      "type": "object",
      "required": ["checksum", "checksum_algorithm"],
      "properties": {
        "checksum": {
          "type": "string",
          "description": "Checksum of pulse sequence data"
        },
        "checksum_algorithm": {
          "type": "string",
          "enum": ["sha256", "crc32", "md5"],
          "description": "Algorithm used for checksum"
        },
        "total_duration": {
          "type": "number",
          "minimum": 0,
          "description": "Total trace duration in nanoseconds"
        },
        "pulse_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of pulses"
        }
      },
      "description": "Integrity verification metadata"
    }
  }
}
