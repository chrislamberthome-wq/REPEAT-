{\n  "$schema": "http://json-schema.org/draft-07/schema#",\n  "title": "Verification Receipt",\n  "type": "object",\n  "additionalProperties": false,\n  "required": [\n    "schema_version",\n    "receipt_id",\n    "subject_id",\n    "verifier_id",\n    "policy_id",\n    "timestamp",\n    "advertised_iam",\n    "policy_cap",\n    "required_iam",\n    "effective_iam",\n    "crc_ok",\n    "sig_ok",\n    "outcome",\n    "prev_receipt_sha256",\n    "receipt_sha256",\n    "signature"\n  ],\n  "properties": {\n    "schema_version": {\n      "type": "string",\n      "const": "repeat-receipt-v1"\n    },\n    "receipt_id": {"type": "string"},\n    "subject_id": {"type": "string"},\n    "verifier_id": {"type": "string"},\n    "policy_id": {"type": "string"},\n    "timestamp": {"type": "string", "format": "date-time"},\n    "advertised_iam": {"type": "integer", "minimum": 0, "maximum": 3},\n    "policy_cap": {"type": "integer", "minimum": 0, "maximum": 3},\n    "required_iam": {"type": "integer", "minimum": 0, "maximum": 3},\n    "effective_iam": {"type": "integer", "minimum": 0, "maximum": 3},\n    "crc_ok": {"type": "boolean"},\n    "sig_ok": {"type": "boolean"},\n    "outcome": {"type": "string", "enum": ["PASS", "FAIL", "ERROR"]},\n    "prev_receipt_sha256": {"type": "string"},\n    "state_sha256": {"type": "string"},\n    "receipt_sha256": {"type": "string"},\n    "signature": {"type": "string"}\n  }\n}