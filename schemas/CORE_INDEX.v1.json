{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrislamberthome-wq/REPEAT-/schemas/CORE_INDEX.v1.json",
  "title": "REPEAT Core Artifact Index v1",
  "description": "Machine-readable registration and precedence index for REPEAT_CORE_v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "index_id",
    "core_authority",
    "artifacts",
    "precedence"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "index_id": {
      "const": "CORE_INDEX_v1"
    },
    "core_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "status",
        "semantic_certification"
      ],
      "properties": {
        "authority_id": {
          "const": "REPEAT_CORE_v1"
        },
        "status": {
          "enum": [
            "pending",
            "active",
            "retired"
          ]
        },
        "semantic_certification": {
          "enum": [
            "uncertified",
            "certified"
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "precedence": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/precedenceEntry"
      }
    }
  },
  "artifacts": [
    {
      "artifact_id": "CORE_INDEX_v1",
      "relative_path": "schemas/CORE_INDEX.v1.json",
      "type": "authority-index",
      "classification": "normative",
      "sha256": "sha256:PLACEHOLDER:CORE_INDEX_v1"
    },
    {
      "artifact_id": "BOUNDARY_AUTHORITY_v1",
      "relative_path": "docs/boundary-authority-v1.md",
      "type": "governance-document",
      "classification": "normative",
      "sha256": "sha256:PLACEHOLDER:BOUNDARY_AUTHORITY_v1"
    },
    {
      "artifact_id": "REPEAT_SCHEMA_v1",
      "relative_path": "schemas/REPEAT_v1.json",
      "type": "schema",
      "classification": "candidate",
      "sha256": "sha256:PLACEHOLDER:REPEAT_SCHEMA_v1"
    },
    {
      "artifact_id": "C14N_RULES_v1",
      "relative_path": "C14N_RULES.md",
      "type": "canonicalization-rules",
      "classification": "normative",
      "sha256": "sha256:PLACEHOLDER:C14N_RULES_v1"
    },
    {
      "artifact_id": "VERIFIER_ENGINE_v1",
      "relative_path": "verifier/__main__.py",
      "type": "verifier",
      "classification": "candidate",
      "sha256": "sha256:PLACEHOLDER:VERIFIER_ENGINE_v1"
    },
    {
      "artifact_id": "BOUNDARY_AUDIT_20260920",
      "relative_path": "audits/2026-09-20_repeat-core-boundary-audit.md",
      "type": "audit-record",
      "classification": "non-normative",
      "sha256": "sha256:PLACEHOLDER:BOUNDARY_AUDIT_20260920"
    }
  ],
  "precedence": [
    {
      "tier": 1,
      "name": "REPEAT_CORE_v1 Source Authority",
      "artifact_id": "REPEAT_CORE_v1"
    },
    {
      "tier": 2,
      "name": "Machine-Readable Registry Index",
      "artifact_id": "CORE_INDEX_v1"
    },
    {
      "tier": 3,
      "name": "Human-Readable Governance Boundary",
      "artifact_id": "BOUNDARY_AUTHORITY_v1"
    },
    {
      "tier": 4,
      "name": "Canonical Core Schema Specification",
      "artifact_id": "REPEAT_SCHEMA_v1"
    },
    {
      "tier": 5,
      "name": "Canonicalization & Hashing Specification",
      "artifact_id": "C14N_RULES_v1"
    },
    {
      "tier": 6,
      "name": "Verifier Engine Implementation",
      "artifact_id": "VERIFIER_ENGINE_v1"
    },
    {
      "tier": 7,
      "name": "Historical Boundary Audit Record",
      "artifact_id": "BOUNDARY_AUDIT_20260920"
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "relative_path",
        "type",
        "classification",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\x00]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "authority-index",
            "schema",
            "canonicalization-rules",
            "verifier",
            "governance-document",
            "audit-record",
            "test",
            "tool",
            "documentation"
          ]
        },
        "classification": {
          "enum": [
            "candidate",
            "normative",
            "non-normative"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-fA-F]{64}|sha256:PLACEHOLDER:[A-Za-z0-9._-]+)$"
        }
      }
    },
    "precedenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "name",
        "artifact_id"
      ],
      "properties": {
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    }
  }
}

























































