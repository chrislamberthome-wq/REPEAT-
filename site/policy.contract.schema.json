{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SITE-POL Policy Contract",
  "description": "Schema for the release governance policy contract.",
  "type": "object",
  "required": ["version", "id", "policies"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string"},
    "id": {"type": "string"},
    "description": {"type": "string"},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SITE-POL-[0-9]+$"
          },
          "level": {
            "type": "string",
            "enum": ["required", "advisory"]
          },
          "description": {"type": "string"}
        }
      }
    }
  }
}
