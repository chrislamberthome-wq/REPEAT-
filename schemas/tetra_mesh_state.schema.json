{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tetra_mesh_state.schema.json",
  "title": "Tetrahedral Mesh State",
  "description": "Schema for a tetrahedral mesh state used in the Tetrahedral Mesh Protocol (TMP).",
  "type": "object",
  "required": ["mesh_id", "cells"],
  "additionalProperties": false,
  "properties": {
    "mesh_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the mesh."
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "description": "List of tetrahedral cells comprising the mesh.",
      "items": {
        "$ref": "#/definitions/TetraCell"
      }
    }
  },
  "definitions": {
    "Coordinate3D": {
      "type": "array",
      "description": "A 3D coordinate [x, y, z].",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "TetraCell": {
      "type": "object",
      "required": ["cell_id", "vertex_ids", "vertices", "orientation", "volume"],
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for this tetrahedral cell."
        },
        "vertex_ids": {
          "type": "array",
          "description": "Ordered list of exactly four vertex IDs.",
          "items": {"type": "string"},
          "minItems": 4,
          "maxItems": 4
        },
        "vertices": {
          "type": "object",
          "description": "Map from vertex ID to [x, y, z] coordinate.",
          "minProperties": 4,
          "maxProperties": 4,
          "additionalProperties": {"$ref": "#/definitions/Coordinate3D"}
        },
        "orientation": {
          "type": "string",
          "enum": ["positive", "negative"],
          "description": "Declared handedness of the tetrahedron."
        },
        "volume": {
          "type": "number",
          "description": "Declared signed volume of the tetrahedron (1/6 * det)."
        }
      }
    }
  }
}
