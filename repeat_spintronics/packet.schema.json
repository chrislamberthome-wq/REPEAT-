{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repeat.spintronics/packet.schema.json",
  "title": "MRAM Write/Read Packet Schema",
  "description": "Schema for MRAM write and read packetization with magnetization textures",
  "type": "object",
  "required": ["version", "packet_id", "operation", "timestamp", "data", "checksum"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "default": "1.0.0"
    },
    "packet_id": {
      "type": "string",
      "description": "Unique packet identifier (UUID v4)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "type": "string",
      "description": "MRAM operation type",
      "enum": ["write", "read"]
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of packet creation",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "description": "Payload data for the operation",
      "required": ["textures", "metadata"],
      "properties": {
        "textures": {
          "type": "array",
          "description": "Magnetization textures (5-angle tuples from Platonic solids)",
          "items": {
            "type": "array",
            "description": "5-angle tuple: (α_T, α_C, α_O, α_D, α_I)",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "number",
              "description": "Angle in radians"
            }
          }
        },
        "metadata": {
          "type": "object",
          "description": "Metadata about the encoded data",
          "required": ["byte_count", "encoding_method"],
          "properties": {
            "byte_count": {
              "type": "integer",
              "description": "Number of bytes encoded",
              "minimum": 0
            },
            "encoding_method": {
              "type": "string",
              "description": "Encoding method used",
              "enum": ["tetrahedron_5solids"]
            },
            "original_hash": {
              "type": "string",
              "description": "SHA-256 hash of original data (hex)",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "checksum": {
      "type": "string",
      "description": "SHA-256 checksum of packet data (hex)",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
