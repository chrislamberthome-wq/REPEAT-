{\n  "$schema": "https://json-schema.org/draft/2020-12/schema",\n  "title": "REPEAT Spintronics Receipt v1 (MRAM MVP)",\n  "type": "object",\n  "required": [\n    "schema_id",\n    "receipt_id",\n    "run_utc",\n    "packet_hash_sha256",\n    "evidence_hash_sha256",\n    "receipt_hash_sha256",\n    "evidence",\n    "verdict",\n    "metrics"\n  ],\n  "properties": {\n    "schema_id": { "const": "repeat-spintronics-receipt-v1" },\n    "receipt_id": { "type": "string", "minLength": 1 },\n    "run_utc": { "type": "string", "format": "date-time", "minLength": 1 },\n    "packet_hash_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },\n    "evidence_hash_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },\n    "receipt_hash_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },\n    "evidence": {\n      "type": "object",\n      "required": [\n        "run_id",\n        "pulse_waveform_hash",\n        "measured_resistances_ohm",\n        "baseline_resistances_ohm",\n        "mean_resistance_ohm",\n        "std_resistance_ohm",\n        "ambient_temperature_C"\n      ],\n      "properties": {\n        "run_id": { "type": "string", "minLength": 1 },\n        "pulse_waveform_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },\n        "measured_resistances_ohm": {\n          "type": "array",\n          "minItems": 1,\n          "items": { "type": "number", "exclusiveMinimum": 0 }\n        },\n        "baseline_resistances_ohm": {\n          "type": "array",\n          "minItems": 1,\n          "items": { "type": "number", "exclusiveMinimum": 0 }\n        },\n        "mean_resistance_ohm": { "type": "number", "exclusiveMinimum": 0 },\n        "std_resistance_ohm": { "type": "number", "minimum": 0 },\n        "ambient_temperature_C": { "type": "number" }\n      },\n      "additionalProperties": false\n    },\n    "verdict": {\n      "type": "object",\n      "required": ["pass", "fail_reason"],\n      "properties": {\n        "pass": { "type": "boolean" },\n        "fail_reason": { "type": ["string", "null"] }\n      },\n      "additionalProperties": false\n    },\n    "metrics": {\n      "type": "object",\n      "required": [\n        "target_state",\n        "classified_state",\n        "threshold_ohm",\n        "drift_pct",\n        "baseline_mean_ohm",\n        "drift_tolerance_pct"\n      ],\n      "properties": {\n        "target_state": { "enum": ["P", "AP"] },\n        "classified_state": { "enum": ["P", "AP"] },\n        "threshold_ohm": { "type": "number", "exclusiveMinimum": 0 },\n        "drift_pct": { "type": "number", "minimum": 0 },\n        "baseline_mean_ohm": { "type": "number", "exclusiveMinimum": 0 },\n        "drift_tolerance_pct": { "type": "number", "minimum": 0 }\n      },\n      "additionalProperties": false\n    }\n  },\n  "additionalProperties": false\n}