{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B4IU-SNN Verdict v0.1",
  "type": "object",
  "required": ["schema", "run_id", "verdict", "policy_version"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "b4iu_snn_verdict_v0.1"},
