{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repeat.org/schemas/receipt/v1",
  "title": "REPEAT Receipt Schema v1",
  "description": "Standard schema for REPEAT protocol execution receipts",
  "type": "object",
  "required": [
    "protocol_id",
    "run_id",
    "inputs_hash",
    "outputs_hash",
    "trace_hash",
    "timestamp",
    "verdict",
    "verifier_version"
  ],
  "properties": {
    "protocol_id": {
      "type": "string",
      "description": "Unique identifier for the protocol (e.g., 'ai_loopback_visual_binary/v1')",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this protocol run",
      "minLength": 1
    },
    "inputs_hash": {
      "type": "string",
      "description": "SHA-256 hash of canonicalized input data",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputs_hash": {
      "type": "string",
      "description": "SHA-256 hash of canonicalized output data",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trace_hash": {
      "type": "string",
      "description": "SHA-256 hash of the complete trace file",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of receipt generation",
      "format": "date-time"
    },
    "verdict": {
      "type": "string",
      "description": "Verification verdict",
      "enum": ["PASS", "FAIL"]
    },
    "verifier_version": {
      "type": "string",
      "description": "Version of the verifier that produced this receipt",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "description": "Optional protocol-specific metadata",
      "additionalProperties": true
    },
    "signature": {
      "type": "string",
      "description": "Optional cryptographic signature of the receipt"
    },
    "crc": {
      "type": "string",
      "description": "Optional checksum for quick integrity verification"
    }
  },
  "additionalProperties": false
}
