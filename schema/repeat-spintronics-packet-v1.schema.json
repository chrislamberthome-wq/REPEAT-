{\n  "$schema": "https://json-schema.org/draft/2020-12/schema",\n  "title": "REPEAT Spintronics Packet v1 (MRAM MVP)",\n  "type": "object",\n  "required": [\n    "schema_id",\n    "packet_id",\n    "created_utc",\n    "device",\n    "write_intent",\n    "read_plan",\n    "verifier"\n  ],\n  "properties": {\n    "schema_id": { "const": "repeat-spintronics-packet-v1" },\n    "packet_id": { "type": "string", "minLength": 1 },\n    "created_utc": { "type": "string", "minLength": 1 },\n\n    "device": {\n      "type": "object",\n      "required": ["device_id", "nominal_Rp_ohm", "nominal_Rap_ohm"],\n      "properties": {\n        "device_id": { "type": "string", "minLength": 1 },\n        "nominal_Rp_ohm": { "type": "number", "exclusiveMinimum": 0 },\n        "nominal_Rap_ohm": { "type": "number", "exclusiveMinimum": 0 }\n      },\n      "additionalProperties": false\n    },\n\n    "write_intent": {\n      "type": "object",\n      "required": ["target_state", "pulse_amplitude_mA", "pulse_width_ns", "temperature_C"],\n      "properties": {\n        "target_state": { "enum": ["P", "AP"] },\n        "pulse_amplitude_mA": { "type": "number" },\n        "pulse_width_ns": { "type": "number", "exclusiveMinimum": 0 },\n        "temperature_C": { "type": "number" }\n      },\n      "additionalProperties": false\n    },\n\n    "read_plan": {\n      "type": "object",\n      "required": ["read_current_mA", "samples"],\n      "properties": {\n        "read_current_mA": { "type": "number", "exclusiveMinimum": 0 },\n        "samples": { "type": "integer", "minimum": 1 }\n      },\n      "additionalProperties": false\n    },\n\n    "verifier": {\n      "type": "object",\n      "required": ["verifier_id", "params"],\n      "properties": {\n        "verifier_id": { "const": "mram_switch_v1" },\n        "params": {\n          "type": "object",\n          "required": ["threshold_ohm", "drift_tolerance_pct", "baseline_runs"],\n          "properties": {\n            "threshold_ohm": { "type": "number", "exclusiveMinimum": 0 },\n            "drift_tolerance_pct": { "type": "number", "minimum": 0 },\n            "baseline_runs": { "type": "integer", "minimum": 1 }\n          },\n          "additionalProperties": false\n        }\n      },\n      "additionalProperties": false\n    },\n\n    "notes": { "type": "string" }\n  },\n  "additionalProperties": false\n}