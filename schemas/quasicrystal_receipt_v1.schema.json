{\n  "$schema": "http://json-schema.org/draft-07/schema#",\n  "title": "Quasicrystal Receipt",\n  "type": "object",\n  "properties": {\n    "id": {\n      "type": "string",\n      "description": "Unique identifier for the receipt"\n    },\n    "date": {\n      "type": "string",\n      "format": "date-time",\n      "description": "Date and time of the receipt issuance"\n    },\n    "total": {\n      "type": "number",\n      "description": "Total amount of the transaction"\n    },\n    "items": {\n      "type": "array",\n      "items": {\n        "type": "object",\n        "properties": {\n          "name": {\n            "type": "string",\n            "description": "Name of the item"\n          },\n          "quantity": {\n            "type": "integer",\n            "description": "Quantity of the item"\n          },\n          "price": {\n            "type": "number",\n            "description": "Price of the item"\n          }\n        },\n        "required": ["name", "quantity", "price"]\n      }\n    }\n  },\n  "required": ["id", "date", "total", "items"]\n}